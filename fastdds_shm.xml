<?xml version="1.0" encoding="UTF-8" ?>
<!-- 카메라 영상(프레임당 ~0.9MB)이 공유메모리로 전달되도록 SHM 세그먼트를 키운 FastDDS 프로파일.
     기본 세그먼트(~0.5MB)보다 프레임이 커서 UDP 조각 전송으로 밀리며 프레임이 유실됐다. UDP도 같이 두어 디스커버리/다른 전송은 그대로 동작한다. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_big</transport_id>
      <type>SHM</type>
      <segment_size>134217728</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="default_participant" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>shm_big</transport_id>
        <transport_id>udp</transport_id>
      </userTransports>
    </rtps>
  </participant>
</profiles>
